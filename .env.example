# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string.
# Local development and production can share the same database while this is
# still a prototype — or use two, if you prefer to keep test accounts separate.
# Neon (free): https://neon.tech  ·  or add Postgres in the Vercel dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the login session cookie. Any long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional. Without it the study assistant uses its built-in written answers,
# which is the current intended behaviour for the prototype.
OPENAI_API_KEY=""
