generator client {
  provider = "prisma-client-js"
}

// Postgres, not SQLite: Vercel runs each request in a serverless function with
// no persistent filesystem, so a .db file cannot work there. Any hosted
// Postgres (Neon, Vercel Postgres, Supabase) works — it is one connection
// string either way.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Content model: everyday situations, not exam parts.
//
// Analysis v2 ch. 3.1 and 3.2 put inburgering / B1 exam preparation explicitly
// out of scope, so the previous ExamPart taxonomy (Reading / Writing /
// Listening / Speaking / KNM) was removed. The content is now organised by the
// daily situation a learner wants to handle, which is what sub-question 2
// ("In which daily situations do expats need Dutch the most?") asks about.
//
// EVIDENCE STATUS: the situation list itself is a design hypothesis. Which
// situations actually matter must come from the interviews (ch. 8, planned).
// The structure below is deliberately data-driven so situations can be added,
// reordered or removed after the interviews without touching the player code.
// ---------------------------------------------------------------------------

enum Level {
  A0
  A1
  A2
}

enum Speaker {
  PARTNER // the Dutch person in the conversation
  LEARNER // the user chooses what to say
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress     ScenarioProgress[]
  chatMessages ChatMessage[]
}

/// One everyday situation, e.g. "Ordering coffee".
model Scenario {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  dutchTitle  String
  description String
  /// Short line shown before starting: where you are, who you are talking to.
  setting     String  @default("")
  level       Level   @default(A1)
  icon        String  @default("MessageCircle")
  minutes     Int     @default(5)
  order       Int
  /// false = listed as a planned situation, not yet written
  published   Boolean @default(false)

  steps    ScenarioStep[]
  progress ScenarioProgress[]
}

/// One turn in the conversation.
model ScenarioStep {
  id         String  @id @default(cuid())
  scenarioId String
  order      Int
  speaker    Speaker
  /// What the partner says (PARTNER steps), or the prompt for the learner.
  dutch      String
  english    String
  /// Optional nudge shown if the learner asks for a hint.
  hint       String  @default("")

  scenario Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  choices  ScenarioChoice[]
}

/// A reply the learner can pick on a LEARNER step.
model ScenarioChoice {
  id        String  @id @default(cuid())
  stepId    String
  order     Int
  dutch     String
  english   String
  isCorrect Boolean @default(false)
  /// Why this reply works, or why it does not.
  feedback  String

  step ScenarioStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model ScenarioProgress {
  id           String    @id @default(cuid())
  userId       String
  scenarioId   String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  /// Best result so far, used to show "3 / 4 right" on the situation card.
  bestCorrect  Int       @default(0)
  totalChoices Int       @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
